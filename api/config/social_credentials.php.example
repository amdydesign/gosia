/**
 * Konfiguracja integracji social media (opcjonalna).
 *
 * Nazwy profili (Instagram, Facebook, YouTube, TikTok) ustawia się w aplikacji:
 * Statystyki -> "Profile social". Poniższe klucze zwiększają niezawodność pobierania:
 *  - youtube.api_key   -> darmowy klucz YouTube Data API v3 (console.cloud.google.com), 10 000 zapytań/dzień
 *  - rapidapi          -> płatny scraper Instagrama (awaryjnie, gdy publiczne pobieranie zawiedzie)
 *  - facebook_rapidapi -> płatny scraper Facebooka (awaryjnie)
 *  - tiktok / facebook -> OAuth (opcjonalnie, do "Połącz konto")
 */
return [
    'youtube' => [
        'api_key' => 'YOUR_YOUTUBE_API_KEY',
        // OAuth (opcjonalnie)
        'client_id' => '',
        'client_secret' => '',
        'redirect_uri' => 'https://panel.example.pl/auth/callback/youtube',
    ],
    'tiktok' => [
        'client_key' => 'YOUR_TIKTOK_CLIENT_KEY',
        'client_secret' => 'YOUR_TIKTOK_CLIENT_SECRET',
        'redirect_uri' => 'https://panel.example.pl/auth/callback/tiktok',
    ],
    'facebook' => [
        'app_id' => 'YOUR_FACEBOOK_APP_ID',
        'app_secret' => 'YOUR_FACEBOOK_APP_SECRET',
        'redirect_uri' => 'https://panel.example.pl/auth/callback/facebook',
    ],
    // Awaryjne scrapery RapidAPI (płatne). Zostaw puste, jeśli nie używasz.
    'rapidapi' => [
        'key' => '',
        'host' => 'instagram-scraper-api2.p.rapidapi.com',
        'username' => '', // legacy: nazwa profilu IG (lepiej ustawić w aplikacji)
    ],
    'facebook_rapidapi' => [
        'key' => '',
        'host' => 'facebook-scraper3.p.rapidapi.com',
        'url' => '', // legacy: adres strony FB (lepiej ustawić w aplikacji)
    ],
];
