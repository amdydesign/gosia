DB_HOST=localhost
DB_NAME=gosia
DB_USER=root
DB_PASS=
APP_DEBUG=false

# Web Push (VAPID) - wygeneruj: php api/utils/generate_vapid_keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj-email@example.com

# Sekret dla cronów wywoływanych przez URL (api/cron/send_reminders.php?secret=...)
CRON_SECRET=

# Czytanie screenów zakupów / zleceń (AI) - wystarczy JEDEN klucz
# Claude: https://console.anthropic.com  |  Gemini: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gdy ustawione oba klucze: claude | gemini
AI_PROVIDER=
# Opcjonalnie inny model (domyślnie claude-opus-5-5 / gemini-flash-latest)
ANTHROPIC_MODEL=
GEMINI_MODEL=
