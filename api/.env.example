# --- Baza danych ---
DB_HOST=localhost
DB_NAME=gosia
DB_USER=root
DB_PASS=

# --- Aplikacja ---
# true = pelne komunikaty bledow w odpowiedziach API (tylko lokalnie!)
APP_DEBUG=false
# Adres aplikacji (uzywany jako issuer tokenow JWT)
APP_URL=https://panel.example.pl

# --- JWT (WYMAGANE) ---
# Wygeneruj dlugi losowy sekret, np.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# --- Web Push (VAPID) - wygeneruj: php api/utils/generate_vapid_keys.php ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj-email@example.com

# --- Sekret dla cronow wywolywanych przez URL (api/cron/send_reminders.php?secret=...) ---
CRON_SECRET=

# --- Social media (opcjonalne - potrzebne tylko dla integracji statystyk) ---
# YouTube Data API v3 (tryb publiczny po Channel ID)
SOCIAL_YOUTUBE_API_KEY=

# TikTok OAuth (developers.tiktok.com)
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_TIKTOK_REDIRECT_URI=

# Facebook OAuth (developers.facebook.com)
SOCIAL_FACEBOOK_APP_ID=
SOCIAL_FACEBOOK_APP_SECRET=
SOCIAL_FACEBOOK_REDIRECT_URI=

# Instagram OAuth
SOCIAL_INSTAGRAM_APP_ID=
SOCIAL_INSTAGRAM_APP_SECRET=
SOCIAL_INSTAGRAM_REDIRECT_URI=

# RapidAPI (scrapery Instagram/Facebook)
SOCIAL_RAPIDAPI_KEY=
SOCIAL_RAPIDAPI_INSTAGRAM_HOST=
SOCIAL_RAPIDAPI_FACEBOOK_HOST=
