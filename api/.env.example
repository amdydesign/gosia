DB_HOST=localhost
DB_NAME=gosia
DB_USER=root
DB_PASS=
APP_DEBUG=false
# Sekret logowania (sesja, klucze AI w bazie). Zmiana = wszyscy wylogowani, klucze AI do wpisania ponownie
JWT_SECRET=

# Web Push (VAPID) - wygeneruj: php api/utils/generate_vapid_keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj-email@example.com

# Sekret dla cronów wywoływanych przez URL (api/cron/send_reminders.php?secret=...)
CRON_SECRET=

# Czytanie screenów zakupów / zleceń (AI) - wystarczy JEDEN klucz.
# Zwykle wygodniej wpisać go w aplikacji: Ustawienia -> Czytanie screenów (AI).
# Claude: https://console.anthropic.com  |  Gemini: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gdy ustawione oba klucze: claude | gemini
AI_PROVIDER=
# Opcjonalnie inny model. Domyślnie: screeny claude-haiku-5-5, umowy i „Zrzuć tutaj” claude-sonnet-5-5,
# Gemini: gemini-flash-latest
ANTHROPIC_MODEL=
ANTHROPIC_DOCS_MODEL=
ANTHROPIC_NOTES_MODEL=
GEMINI_MODEL=

# Nadawca maili (link "Nie pamiętasz hasła?"). Domyślnie no-reply@<domena>
MAIL_FROM=

# Kopie zapasowe (robią się same co noc przez crona przypomnień; api/utils/Backup.php).
# Opcjonalnie kopia POZA serwerem - dowolny magazyn zgodny z S3 (Backblaze B2, Cloudflare R2, AWS):
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=
# Hasło szyfrowania kopii poza serwerem (AES-256) - zapisz je też poza serwerem, bez niego kopii nie odczytasz
BACKUP_PASSWORD=
